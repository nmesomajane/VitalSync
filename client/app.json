{
  "expo": {
    "name": "VitalSync",
    "slug": "vitalsync-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vitalsync",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080c14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitalsync.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080c14",
         "sounds": ["./assets/sounds/alarm.mp3"],
         "androidMode": "default"
      },
      
      "package": "com.vitalsync.app",
      "googleServicesFile": "./google-services.json"
      
    
    },
    "web": {
        "bundler": "metro"
      },

    "plugins": [
      "expo-web-browser",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "6be6e698-2e89-45c3-90b7-24c79fd8e1c7"
      }
    }
  }
}
