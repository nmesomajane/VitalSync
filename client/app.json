{
  "expo": {
    "name": "VitalSync",
    "slug": "vitalsync-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vitalsync",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#080c14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitalsync.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080c14"
      },
      "web": {
        "bundler": "metro"
      },
      "package": "com.vitalsync.app"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "6be6e698-2e89-45c3-90b7-24c79fd8e1c7"
      }
    }
  }
}
